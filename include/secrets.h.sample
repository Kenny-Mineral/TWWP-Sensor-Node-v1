#pragma once

// Copy this file to include/secrets.h and fill in your values.
// secrets.h is gitignored — never commit it.

#define NODE_ID     "wh_001"          // Unique per device, e.g. wh_001, wh_002
#define MQTT_HOST   "twwp-iot.duckdns.org"    // DNS name only, never a raw IP
#define MQTT_PORT   8883
#define MQTT_USER   "twwp_wh_001"
#define MQTT_PASS   "changeme"
#define AP_PASS     "change-this-ap-password"
// Optional override; if omitted the firmware uses "twwp-" + NODE_ID.
// #define AP_SSID  "twwp-wh_001"

// Let's Encrypt ISRG Root X1 CA cert as raw PEM string literal.
// Paste the full cert between the quotes. Keep the \n at line endings.
#define MQTT_CA_CERT \
    "-----BEGIN CERTIFICATE-----\n" \
    "REPLACE_WITH_YOUR_CA_CERT\n" \
    "-----END CERTIFICATE-----\n"

// Optional: separate CA for the firmware download host used by MQTT-driven OTA.
// If omitted in include/secrets.h, OTA falls back to MQTT_CA_CERT.
// Define this when your OTA file host uses a different CA chain than the broker.
// #define OTA_CA_CERT \
//     "-----BEGIN CERTIFICATE-----\n" \
//     "REPLACE_WITH_YOUR_OTA_CA_CERT\n" \
//     "-----END CERTIFICATE-----\n"
